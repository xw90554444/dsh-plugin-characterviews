{
  "name": "dsh-plugin-characterviews",
  "version": "0.1.0",
  "private": true,
  "description": "Character Multi-View — upload one photo, render the same character from front/side/back/custom angles on a local ComfyUI (Qwen-Image 2.1).",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./angles": "./lib/angles.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
